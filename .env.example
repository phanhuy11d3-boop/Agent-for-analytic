# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: ninerouter | openrouter | groq
LLM_PROVIDER=ninerouter

# ── 9router (active default) ──────────────────────────────────────────────────
NINEROUTER_API_KEY=your-ninerouter-key
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_MODEL=kc/deepseek/deepseek-chat

# ── OpenRouter (fallback) ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
# OPENROUTER_MODELS=model1,model2     # comma-separated fallback list
OPENROUTER_TIMEOUT=20

# ── Groq (fallback) ───────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
# GROQ_API_KEYS=key1,key2             # comma-separated for rate-limit retry
GROQ_MODEL=llama-3.3-70b-versatile

# ── Sampling & Profiling ──────────────────────────────────────────────────────
QUERY_SAMPLE_LIMIT=1000              # max rows fetched by data_agent preview query
PROFILE_SAMPLE_LIMIT=1000            # rows used for table profiling
SEMANTIC_PROFILE_SAMPLE_LIMIT=300    # rows used for semantic gate profiling (tighter budget)
PROFILE_TOP_N=10                     # top-N distinct values tracked per column
PROFILE_COLUMN_LIMIT=80              # max columns profiled per table

# ── Analysis ──────────────────────────────────────────────────────────────────
ANALYSIS_TIMEOUT_SECONDS=180         # WebSocket analysis timeout
SEMANTIC_PROPOSAL_USE_LLM=1          # 0 = skip LLM in semantic_agent propose step
